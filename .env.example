# Copy to .env.local. Never commit .env.local or paste service keys into chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Absolute origin, no trailing slash. Use your deployed HTTPS origin in production.
APP_ORIGIN=http://localhost:3000
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
VERIFICATION_HMAC_KEY=
RATE_LIMIT_HMAC_KEY=
CRON_SECRET=
# Optional: lower the 16 MiB audio upload cap; hard maximum cannot be raised.
# Requires additive migration 004; photos retain their separate 3 MiB cap.
MAX_AUDIO_UPLOAD_BYTES=16777216
