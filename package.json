    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "mpg123-decoder": "1.0.3",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
